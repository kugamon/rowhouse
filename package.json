{
  "name": "rowhouse",
  "private": true,
  "version": "0.1.0",
  "description": "Rowhouse — a free, open-source grid component for Salesforce",
  "license": "AGPL-3.0",
  "homepage": "https://rowhouse.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kugamon/rowhouse.git"
  },
  "bugs": {
    "url": "https://github.com/kugamon/rowhouse/issues"
  },
  "scripts": {
    "test:unit": "sfdx-lwc-jest",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "lint": "eslint force-app --max-warnings 0",
    "check:rules": "node scripts/checks/run-all.js",
    "guide": "node guide/build.js",
    "verify": "npm run check:selftest && npm run check:rules && npm run format:check && npm run lint && npm run lint:slds && npm run test:data && npm run test:unit",
    "test:data": "python3 test-data/scripts/test_generate_benchmark.py",
    "check:selftest": "node scripts/checks/self-test.js && node eslint-rules/tests/run.js",
    "lint:slds": "slds-linter lint force-app",
    "format": "prettier --write \"**/*.{cls,trigger,js,html,css,yml}\"",
    "format:check": "prettier --check \"**/*.{cls,trigger,js,html,css,yml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.5.0",
    "@lwc/template-compiler": "^9.5.2",
    "@sa11y/jest": "^8.2.1",
    "@salesforce-ux/slds-linter": "1.2.1",
    "@salesforce/eslint-config-lwc": "^4.1.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.17.0",
    "fast-xml-parser": "^5.11.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-apex": "2.3.0"
  },
  "lint-staged": {
    "*.{cls,trigger,js,html,css,yml}": "prettier --write"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "js-yaml@3": {
      "argparse": "^2.0.1"
    }
  }
}
